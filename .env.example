# Shared secret for the /api/revalidate webhook. Generate any long random
# string (e.g. `openssl rand -hex 32`) and set the same value here and as
# the REVALIDATE_SECRET secret on the product repo(s) that call this route.
REVALIDATE_SECRET=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Analytics only
# loads after a visitor accepts cookies, and not at all when this is empty.
NEXT_PUBLIC_GA_ID=
